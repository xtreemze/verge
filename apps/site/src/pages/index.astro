---
import {
  PREFERRED_AUDIO_MIME_TYPES,
  PREFERRED_VIDEO_MIME_TYPES,
  codecDisplayName
} from "@verge/webrtc/codec-policy";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function codecPolicyNote(mimeType: string): string {
  switch (mimeType.toLowerCase()) {
    case "video/av1":
    case "video/vp9":
      return "preferred when the browser exposes it";
    case "video/h265":
      return "used when the platform exposes HEVC";
    case "video/h264":
      return "broad compatibility path";
    case "video/vp8":
      return "compatibility fallback";
    case "audio/opus":
      return "preferred audio codec";
    default:
      return "runtime capability";
  }
}

const codecPolicy = [
  ...PREFERRED_VIDEO_MIME_TYPES,
  ...PREFERRED_AUDIO_MIME_TYPES
].map((mimeType) => ({
  mimeType,
  label: codecDisplayName(mimeType),
  note: codecPolicyNote(mimeType)
}));

const features = [
  {
    icon: "video",
    title: "Camera + microphone",
    copy:
      "Small-room multi-party conferencing over standards-based WebRTC with browser media capture."
  },
  {
    icon: "screen",
    title: "Screen sharing",
    copy:
      "Share a screen, window, or tab and switch back to camera without rebuilding the room."
  },
  {
    icon: "chat",
    title: "Chat + files",
    copy:
      "Peer-to-peer text chat and chunked, SHA-256 verified file exchange, with large receives streamed to browser storage when available."
  },
  {
    icon: "audio",
    title: "Audio profiles",
    copy:
      "Speech mode requests echo cancellation, noise suppression, and gain control. Original-audio mode preserves stereo."
  },
  {
    icon: "codec",
    title: "Runtime codec policy",
    copy:
      "Peers apply the shared preference policy to codecs the current browser actually exposes instead of assuming one format everywhere."
  },
  {
    icon: "shield",
    title: "Authenticated room access",
    copy:
      "Signed, expiring invitations gate production joins and TURN credentials are short-lived and server-derived. Media and app data stay on WebRTC paths."
  }
] as const;
---

<BaseLayout
  title="Verge — peer-to-peer conferencing at the edge"
  description="Verge is browser-first peer-to-peer video, audio, screen sharing, chat, and verified file transfer for small rooms."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Browser-first · peer-to-peer by default</p>
      <h1>Meet at the edge.</h1>
      <p>
        Verge keeps small-room conferencing close to the people in
        the call: camera, audio, screen sharing, chat, and verified
        file exchange over WebRTC. Production rooms add signed,
        expiring invitations and short-lived TURN credentials without
        moving conference media through the signaling plane.
      </p>

      <div class="hero-actions">
        <a class="button primary" href={`${base}/onboarding/`}>
          Start onboarding
        </a>
        <a
          class="button ghost"
          href="https://github.com/xtreemze/verge"
        >
          View source
        </a>
      </div>

      <ul class="hero-facts" aria-label="Verge highlights">
        <li>MVP release candidate</li>
        <li>Direct + TURN-certified</li>
        <li>Android acceptance harness</li>
      </ul>
    </div>

    <div class="conference-preview" aria-hidden="true">
      <div class="preview-topbar">
        <span class="preview-room">studio-42</span>
        <span class="preview-status">4 peers · negotiated media</span>
      </div>
      <div class="preview-grid">
        <div class="preview-tile">
          <span class="preview-person"></span>
          <span class="preview-name">You</span>
        </div>
        <div class="preview-tile">
          <span class="preview-person"></span>
          <span class="preview-name">Mina</span>
        </div>
        <div class="preview-tile">
          <span class="preview-person"></span>
          <span class="preview-name">Alex</span>
        </div>
        <div class="preview-tile">
          <span class="preview-person"></span>
          <span class="preview-name">Sam</span>
        </div>
      </div>
      <div class="preview-controls">
        <span class="preview-control">Mic</span>
        <span class="preview-control">Cam</span>
        <span class="preview-control">Share</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="kicker">Architecture</p>
      <h2>Direct where it matters.</h2>
      <p>
        Verge separates rendezvous from the actual conversation.
        Signaling helps peers find each other; WebRTC carries the
        media and data. Production rooms authenticate entry with
        expiring invitations, derive short-lived TURN credentials,
        and recover bounded signaling interruptions without moving
        conference media into the control plane.
      </p>
    </div>

    <div class="architecture-grid">
      <article class="arch-card">
        <span class="arch-index">01 · CAPTURE</span>
        <h3>Your browser owns your devices</h3>
        <p>
          Camera, microphone, display capture, device selection, and
          media processing stay at the client boundary.
        </p>
        <div class="flow-line" aria-hidden="true">
          <span>camera</span><i></i><span>peer</span>
        </div>
      </article>

      <article class="arch-card">
        <span class="arch-index">02 · RENDEZVOUS</span>
        <h3>Control stays small</h3>
        <p>
          The production control plane authenticates room entry,
          issues time-limited TURN credentials, tracks ephemeral
          membership, and forwards SDP/ICE messages. It does not
          ingest conference media.
        </p>
        <div class="flow-line" aria-hidden="true">
          <span>SDP/ICE</span><i></i><span>room</span>
        </div>
      </article>

      <article class="arch-card">
        <span class="arch-index">03 · TRANSPORT</span>
        <h3>Peers carry the room</h3>
        <p>
          SRTP handles media and ordered data channels carry chat and
          files. A topology-neutral contract leaves room for a future
          SFU.
        </p>
        <div class="flow-line" aria-hidden="true">
          <span>WebRTC</span><i></i><span>WebRTC</span>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="kicker">Everything in the room</p>
      <h2>One surface for the call.</h2>
      <p>
        Verge is deliberately focused: a small set of conference
        capabilities with strong TypeScript boundaries and a browser
        reference implementation.
      </p>
    </div>

    <div class="feature-grid">
      {
        features.map((feature) => (
          <article class="feature-card">
            <Icon name={feature.icon} />
            <h3>{feature.title}</h3>
            <p>{feature.copy}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="codec-panel">
      <div class="codec-copy">
        <p class="kicker">Media policy</p>
        <h3>Capability first, not codec dogma.</h3>
        <p>
          Verge starts from the browser's actual WebRTC capabilities
          and applies the same preference policy shown here before
          negotiation. Unsupported formats are skipped; the exact
          result remains a runtime property of the call.
        </p>
      </div>

      <ul class="codec-list">
        {
          codecPolicy.map((codec) => (
            <li>
              <strong>{codec.label}</strong>
              <span>{codec.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="cta-panel">
      <p class="kicker">Open source · self-hostable</p>
      <h2>Bring up a room from the repo.</h2>
      <p>
        The browser client and signaling service live in one pnpm
        workspace. GitHub Pages hosts this static introduction and
        onboarding layer; signaling remains a separate runtime
        service by design.
      </p>
      <div class="command" aria-label="Development commands">
        <span>$</span>
        <span>pnpm install&nbsp;&nbsp;&amp;&amp;&nbsp;&nbsp;pnpm dev</span>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={`${base}/onboarding/`}>
          Check this browser
        </a>
        <a
          class="button ghost"
          href="https://github.com/xtreemze/verge#development"
        >
          Development setup
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
