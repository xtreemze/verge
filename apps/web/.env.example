# Production container defaults to same-origin endpoints:
# VITE_SIGNALING_URL=/ws
# VITE_ICE_CONFIG_URL=/api/ice
#
# Local development normally uses the app defaults:
# signaling -> ws://localhost:8787
# ICE -> public STUN fallback in the mesh transport

# Optional explicit WebSocket endpoint. Relative paths resolve to ws/wss on the
# current origin.
# VITE_SIGNALING_URL=/ws

# Preferred production endpoint returning fresh short-lived ICE/TURN credentials.
# Response shape: {"iceServers":[{"urls":["turn:turn.example.com:3478?transport=udp"],"username":"...","credential":"..."}]}
# VITE_ICE_CONFIG_URL=/api/ice

# Production room creation endpoint. When configured, a fresh lobby mints a
# signed expiring invitation before joining; room IDs alone cannot join.
# VITE_ROOM_INVITE_URL=/api/rooms

# Development/static fallback. Never put long-lived production TURN secrets here.
# VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.example.com:3478"}]

# Test/debug override. Production should normally leave this as "all".
# VITE_ICE_TRANSPORT_POLICY=relay
