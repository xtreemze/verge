# Preferred for production: endpoint returning fresh short-lived ICE/TURN credentials.
# Response shape: {"iceServers":[{"urls":"turns:turn.example.com:5349","username":"...","credential":"..."}]}
VITE_ICE_CONFIG_URL=/api/ice

# WebSocket URL for the signaling service.
VITE_SIGNALING_URL=ws://localhost:8787

# Development/static fallback. Do not put long-lived production TURN secrets here.
# VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.example.com:3478"},{"urls":"turns:turn.example.com:5349","username":"user","credential":"secret"}]
