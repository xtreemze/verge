{
  "name": "verge",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.8.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @verge/signaling --filter @verge/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @verge/web test:e2e",
    "desktop": "pnpm --filter @verge/desktop tauri dev",
    "site:dev": "pnpm --filter @verge/site dev",
    "site:build": "pnpm --filter @verge/site build",
    "android:pair": "bash scripts/adb-two-phone-mvp.sh",
    "android:certify": "node scripts/android-certify.mjs",
    "test:android-certify": "node --test scripts/android-certify-lib.test.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
