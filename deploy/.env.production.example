# Public HTTPS application hostname. Create an A/AAAA record pointing here.
VERGE_DOMAIN=meet.example.com

# TURN hostname. It may resolve to the same host as VERGE_DOMAIN.
VERGE_TURN_HOST=turn.example.com
VERGE_TURN_REALM=turn.example.com

# Public IPv4 address used by coturn to advertise relay candidates.
VERGE_PUBLIC_IP=203.0.113.10

# Generate with: openssl rand -hex 32
VERGE_TURN_SHARED_SECRET=replace-with-a-long-random-secret

# Mesh MVP room guardrail.
VERGE_MAX_ROOM_SIZE=8

# Short-lived browser TURN credentials.
VERGE_TURN_CREDENTIAL_TTL_SECONDS=3600
